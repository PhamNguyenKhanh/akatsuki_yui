# ------------------------------------------------------------------------------
# 1. Runtime Application Variables (Vercel Runtime + Local Development)
# ------------------------------------------------------------------------------
NODE_ENV=
NEXT_PUBLIC_APP_URL=

# Runtime pooled connection (use Neon `-pooler` connection string in Vercel)
DATABASE_URL=

# Auth.js v5 (JWT Session - minimum 32 random chars in production)
AUTH_SECRET=
AUTH_URL=

# Optional behind reverse proxies / Vercel
AUTH_TRUST_HOST=

# Cron authentication (`Bearer <CRON_SECRET>` - DEC-067)
CRON_SECRET=

# Nodemailer SMTP Email Transport (DEC-070 - replaces Resend)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_AUTH_MODE=
SMTP_USER=
SMTP_PASS=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
SMTP_FROM=
SMTP_DAILY_SEND_LIMIT=
SMTP_PER_MINUTE_LIMIT=

# Optional runtime diagnostics
LOG_LEVEL=

# Pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_APP_CLUSTER=

# ------------------------------------------------------------------------------
# 2. Operator / Migration-Only Variables (Local/CI only - NOT needed in Vercel Runtime)
# ------------------------------------------------------------------------------
# Direct unpooled connection required in `.env` by Prisma CLI (`prisma migrate`).
# Local PostgreSQL: set equal to DATABASE_URL. Neon: use the direct non-pooler URL.
DIRECT_URL=

# One-time initial Admin bootstrap for `prisma db seed` (`DEC-067`)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ------------------------------------------------------------------------------
# 3. Isolated Test Runner Only (Never fallback to DATABASE_URL / DIRECT_URL)
# ------------------------------------------------------------------------------
TEST_DATABASE_URL=
